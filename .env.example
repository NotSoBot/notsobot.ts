# the bot's discord token (`Bot` not included)
NOTSOBOT_DISCORD_TOKEN=
# what the bot calls our api with (`Bot` not included)
NOTSOBOT_API_TOKEN=
# the api's events, `wss://gateway.nsb.gg/events` when it's empty
NOTSOBOT_GATEWAY_URL=
# each cluster process' heap limit in megabytes (8 shards each), 2048 when it's empty
NOTSOBOT_CLUSTER_MEMORY=
# debug, info (the default), warn or error. debug adds a line for every discord rest response
NOTSOBOT_LOG_LEVEL=

# errors aren't reported when it's empty
SENTRY_DSN=
# like `SENTRY_ENVIRONMENT=production`
SENTRY_ENVIRONMENT=
# overrides the build's own (lib/release.json, from the Dockerfile), leave it empty so respawned clusters report the code
# they're running
SENTRY_RELEASE=
